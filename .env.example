# Copy to .env.local and fill in. Every variable is optional — see src/config/site.ts for the defaults.
# NEXT_PUBLIC_* values are inlined into the client bundle at build time, so rebuild after changing them.

# Base URL of the RMS backend — host + global prefix + URI version.
# The backend runs on port 5000 with API_PREFIX=api and API_VERSION=1.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1

# Full company name, used as the site description (default: "Restaurant Management System")
NEXT_PUBLIC_COMPANY_NAME=Restaurant Management System

# Short company name, used as the site name (default: "RMS")
NEXT_PUBLIC_COMPANY_SHOT_NAME=RMS
